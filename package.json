
{
  "name": "arc-logos-holy-bible",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "The Holy Bible — an offline-first King James Version Bible reader by Arc.Logos",
  "scripts": {
    "prepare:data": "node scripts/build-translation.mjs",
    "dev": "npm run prepare:data && vite",
    "start": "npm run dev",
    "build:app": "vite build",
    "build:sw": "node scripts/build-service-worker.mjs",
    "build": "npm run prepare:data && node scripts/build-sitemap.mjs && npm run build:app && npm run build:sw",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBigArk/armorer.git"
  },
  "author": "Arc.Logos",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/TheBigArk/armorer/issues"
  },
  "homepage": "https://thefreeholybible.com",
  "dependencies": {
    "minisearch": "^7.2.0",
    "porter-stemmer": "^0.9.1",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.3.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^27.0.0",
    "kjv": "^1.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
